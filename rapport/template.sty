% Capture d'écran ModelSim : affichée si le fichier existe dans figures/,
% sinon un cadre rappelle quoi capturer
% \capture[largeur]{fichier}{ce qu'il faut capturer}{légende}{étiquette}
% (largeur facultative, \linewidth par défaut)
\newcommand{\capture}[5][\linewidth]{%
    \begin{figure}[H]
    \centering
    \IfFileExists{figures/#2}{\includegraphics[width=#1]{figures/#2}}{%
        \fcolorbox{red}{red!5}{\parbox[c][3.2cm][c]{0.92\linewidth}{\centering
        \textcolor{red}{\textbf{Capture à insérer :} \texttt{figures/#2}}\\[2mm]\small #3}}}
    \caption{#4}
    \label{#5}
    \end{figure}}

% Affichage des zones utiles des captures : signaux, puis axe temporel.
% Les PNG originaux restent intacts. Les quatre valeurs de rognage sont en bp.
% #1 fichier, #2 rognage signaux, #3 rognage axe, #4 legende, #5 etiquette.
\newcommand{\simcapture}[5]{%
    \begin{figure}[H]
    \centering
    \includegraphics[width=\linewidth,trim={#2},clip]{figures/#1}\par\vspace{-2pt}
    \includegraphics[width=\linewidth,trim={#3},clip]{figures/#1}
    \caption{#4}
    \label{#5}
    \end{figure}}

% Photo de la carte avec une courte légende, pour les grilles de photos
% \photo[largeur]{fichier}{légende}
\newcommand{\photo}[3][0.32\linewidth]{%
    \begin{minipage}[t]{#1}\centering
    \includegraphics[width=\linewidth]{figures/#2}\\[1mm]{\small #3}
    \end{minipage}}
